---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	title: string;
	summary: string;
	href: string;
	cover: ImageMetadata;
	coverAlt: string;
}

const { title, summary, href, cover, coverAlt } = Astro.props;
---

<article>
	<Image
		class="cover"
		src={cover}
		alt={coverAlt}
		widths={[320, 640, 960]}
		sizes="(min-width: 70rem) 22rem, 100vw"
	/>
	<h2><a href={href}>{title}</a></h2>
	<p>{summary}</p>
</article>

<style>
	article {
		display: grid;
		gap: var(--space-xs);
		align-content: start;
		padding: var(--space-m);
		background-color: var(--color-surface);
		border: 0.0625rem solid var(--color-line);
	}

	.cover {
		inline-size: 100%;
		block-size: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}
</style>
