---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const links = [
	{ path: '', label: 'Home' },
	{ path: 'works/', label: 'Works' },
	{ path: 'passions/', label: 'Passions' },
	{ path: 'about/', label: 'About' },
];

// Compare paths without trailing slashes so /portfolio1 and /portfolio1/ match
const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
---

<header>
	<div class="wrapper bar">
		<a class="name" href={base}>Vittoria Romano</a>

		<!-- Hidden until the script runs, so without JavaScript the links just show -->
		<button type="button" class="menu-button" aria-expanded="false" aria-controls="site-menu" hidden>
			<span class="menu-icon" aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
			</span>
			<span class="menu-label">Menu</span>
		</button>

		<div class="panel" id="site-menu">
			<nav aria-label="Primary">
				<ul>
					{
						links.map(({ path, label }) => {
							const href = `${base}${path}`;
							const isCurrent = normalize(href) === currentPath;
							return (
								<li>
									<a href={href} aria-current={isCurrent ? 'page' : undefined}>
										{label}
									</a>
								</li>
							);
						})
					}
				</ul>
			</nav>

			<div class="mode" role="group" aria-label="Colour mode">
				<button type="button" data-theme-choice="light" aria-pressed="false">
					<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<circle cx="12" cy="12" r="4" />
						<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
					</svg>
					Light
				</button>
				<button type="button" data-theme-choice="dark" aria-pressed="false">
					<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
					</svg>
					Dark
				</button>
			</div>
		</div>
	</div>
</header>

<script>
	const root = document.documentElement;
	const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');

	// A saved choice wins; otherwise follow the system setting
	const activeTheme = () => root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');

	const syncPressed = () => {
		buttons.forEach((button) => {
			button.setAttribute('aria-pressed', String(button.dataset.themeChoice === activeTheme()));
		});
	};

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const theme = button.dataset.themeChoice!;
			root.dataset.theme = theme;
			try {
				localStorage.setItem('theme', theme);
			} catch {
				// Storage blocked: the choice still applies for this page
			}
			syncPressed();
		});
	});

	systemDark.addEventListener('change', syncPressed);
	syncPressed();

	// Menu: the script hides the panel, so without JavaScript the links stay visible
	const menuButton = document.querySelector<HTMLButtonElement>('.menu-button')!;
	const menuLabel = menuButton.querySelector('.menu-label')!;
	const panel = document.getElementById('site-menu')!;

	const setOpen = (open: boolean) => {
		menuButton.setAttribute('aria-expanded', String(open));
		menuLabel.textContent = open ? 'Close' : 'Menu';
		panel.hidden = !open;
	};

	const isOpen = () => menuButton.getAttribute('aria-expanded') === 'true';

	menuButton.hidden = false;
	setOpen(false);

	menuButton.addEventListener('click', () => setOpen(!isOpen()));

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && isOpen()) {
			setOpen(false);
			menuButton.focus();
		}
	});

	document.addEventListener('click', (event) => {
		const target = event.target as Node;
		if (isOpen() && !panel.contains(target) && !menuButton.contains(target)) setOpen(false);
	});

	panel.querySelectorAll('nav a').forEach((link) => {
		link.addEventListener('click', () => setOpen(false));
	});
</script>

<style>
	header {
		background-color: var(--color-sky);
		border-block-end: 0.0625rem solid var(--color-line);
		padding-block: var(--space-s);
	}

	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-s) var(--space-m);
	}

	.name {
		font-weight: 700;
	}

	.panel {
		display: grid;
		flex-basis: 100%;
		gap: var(--space-s);
	}

	ul {
		display: grid;
		padding: 0;
		list-style: none;
	}

	a {
		color: var(--color-ink);
		text-decoration: none;
	}

	nav a {
		display: flex;
		align-items: center;
		min-block-size: 2.75rem;
	}

	a[aria-current='page'] {
		text-decoration-line: underline;
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 0.125rem;
		text-underline-offset: 0.2em;
	}

	a[aria-current='page']:hover {
		text-decoration-thickness: 0.25rem;
	}

	.mode {
		display: flex;
		justify-self: start;
		padding: var(--space-2xs);
		border: 0.0625rem solid var(--color-line);
		border-radius: var(--radius-pill);
		background-color: var(--color-surface);
	}

	button {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		padding-block: var(--space-2xs);
		padding-inline: var(--space-xs);
		border: 0;
		border-radius: var(--radius-pill);
		background-color: transparent;
		color: var(--color-ink);
		font: inherit;
		font-size: var(--step--1);
		cursor: pointer;
	}

	button[aria-pressed='true'] {
		background-color: var(--color-accent);
		color: var(--color-on-pop);
	}

	/* The --color-focus ring comes from global.css; keep the pill shape while focused */
	button:focus-visible {
		border-radius: var(--radius-pill);
	}

	.menu-button {
		gap: var(--space-xs);
		min-block-size: 2.75rem;
		padding-inline: var(--space-s);
		border: 0.0625rem solid var(--color-line);
		background-color: var(--color-surface);
	}

	/* Three lines drawn with borders, so they stay visible in forced-colours mode */
	.menu-icon {
		display: grid;
		gap: 0.25rem;
		inline-size: 1.125rem;
	}

	.menu-icon span {
		border-block-start: 0.125rem solid currentColor;
	}

	/* Lines sit 0.375rem apart (0.25rem gap + 0.125rem line), so move the outer two onto the middle */
	[aria-expanded='true'] .menu-icon span:nth-child(1) {
		transform: translateY(0.375rem) rotate(45deg);
	}

	[aria-expanded='true'] .menu-icon span:nth-child(2) {
		opacity: 0;
	}

	[aria-expanded='true'] .menu-icon span:nth-child(3) {
		transform: translateY(-0.375rem) rotate(-45deg);
	}

	@media (prefers-reduced-motion: no-preference) {
		.menu-icon span {
			transition:
				transform 0.2s ease,
				opacity 0.2s ease;
		}
	}

	svg {
		inline-size: 1rem;
		block-size: 1rem;
	}

	/* .panel and button set display, so restore what the hidden attribute means.
	   Same specificity as those rules, so it has to come last */
	[hidden] {
		display: none;
	}
</style>
