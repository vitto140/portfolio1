---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	/** Let sections run edge to edge: each one brings its own .wrapper */
	bleed?: boolean;
}

const { title, description, bleed = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			// Apply a saved Light / Dark choice before the first paint
			try {
				const theme = localStorage.getItem('theme');
				if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
		<script is:inline>
			// Note the page we leave, so the next page knows where we came from (the work doors use it)
			addEventListener('pagehide', () => {
				try {
					sessionStorage.setItem('from', location.pathname);
				} catch {}
			});

			// Coming back from a work page: show its door wide open from the very first frame,
			// so it can swing shut (WorkCard takes over and removes this). Only with no-preference
			try {
				const id = sessionStorage.getItem('from')?.match(/\/works\/([a-z0-9-]+)\/$/)?.[1];
				if (id && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
					const door = `.work[data-work="${id}"]`;
					const style = document.createElement('style');
					style.id = 'door-back';
					style.textContent = `${door} .door { transform: rotateY(-118deg); } ${door} .shade { opacity: 1; } ${door} .glow { opacity: 1; transform: scale(1.25); }`;
					document.head.append(style);
				}
			} catch {}
		</script>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=JetBrains+Mono:wght@400..800&display=swap"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- For scripts that must run before the first frame, like a page's view transition -->
		<slot name="head" />
	</head>
	<body>
		<Header />
		<main class:list={{ wrapper: !bleed }}>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main.wrapper {
		padding-block: var(--space-xl);
	}
</style>
