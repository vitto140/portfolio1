---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
---

<BaseLayout
	title="About"
	description="Vittoria Romano, web development student: how I work, what I build and how to reach me."
	bleed
>
	<PageHead
		eyebrow="Web development student"
		title="About"
		lede="I'm Vittoria, a web development student. This site is where I collect the things I build in class and on my own, and the things I care about away from the screen."
		sky="glass"
	/>
	<div class="greenhouse">
		<div class="wrapper about-grid">
			<div class="prose">
				<p>
					I build mobile first, starting at 320px and adding breakpoints only where the content needs
					them. I write my own CSS with custom properties and fluid type, without frameworks, because I
					want to understand every line that ships.
				</p>
				<p>
					I work in small branches with reviewed pull requests, and I use AI tools as a collaborator: I
					plan with them, then decide what to keep and what to reject.
				</p>
				<p>
					Want to talk about a project, an internship or something I made? My links are at the bottom of
					every page.
				</p>
			</div>

			<aside class="packet" aria-label="Seed packet">
				<p class="label">Seed packet · No. 01</p>
				<h2>How I grow a site</h2>
				<dl>
					<div>
						<dt>Sow at</dt>
						<dd>320px, mobile first</dd>
					</div>
					<div>
						<dt>Feed with</dt>
						<dd>Own CSS, custom properties, fluid type</dd>
					</div>
					<div>
						<dt>Prune</dt>
						<dd>Small branches, reviewed pull requests</dd>
					</div>
					<div>
						<dt>Light</dt>
						<dd>Light and dark mode</dd>
					</div>
				</dl>
			</aside>
		</div>
	</div>
</BaseLayout>

<style>
	/* Inside the greenhouse: lavender, with the text and the seed packet */
	.greenhouse {
		padding-block: var(--space-2xl);
		background-color: var(--color-lavender);
	}

	.about-grid {
		display: grid;
		gap: var(--space-l);
		align-items: start;
	}

	.prose {
		display: grid;
		gap: var(--space-s);
		max-inline-size: 60ch;
		font-size: var(--step-1);
		line-height: 1.45;
	}

	/* The seed packet: a paper card with a dashed hedge edge, tilted slightly.
	   Muted on surface is 6.23:1 by day and 7.46:1 at night */
	.packet {
		display: grid;
		gap: var(--space-s);
		max-inline-size: 24rem;
		padding: var(--space-m);
		border: 0.125rem dashed var(--color-hedge-deep);
		border-radius: var(--radius-m);
		background-color: var(--color-surface);
		rotate: 1.5deg;
	}

	.label {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--color-muted);
	}

	dl {
		display: grid;
		gap: 0.6rem;
	}

	dl div {
		display: grid;
		gap: 0.1rem;
		padding-block-end: 0.6rem;
		border-block-end: 0.0625rem solid color-mix(in srgb, var(--color-ink) 12%, transparent);
	}

	dt {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-muted);
	}

	/* From 64em the seed packet stands next to the text, as in the design */
	@media (min-width: 64em) {
		.about-grid {
			grid-template-columns: minmax(0, 1fr) 22rem;
		}
	}
</style>
