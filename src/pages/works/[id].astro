---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const works = await getCollection('works');
	return works.map((work) => ({
		params: { id: work.id },
		props: { work },
	}));
}

const { work } = Astro.props;
const { Content } = await render(work);
const { repo, live } = work.data;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title={work.data.title} description={work.data.summary}>
	<p><a href={`${base}works/`}>← All works</a></p>
	<h1>{work.data.title}</h1>
	<p class="summary">{work.data.summary}</p>
	{
		(repo || live) && (
			<ul class="links">
				{repo && (
					<li>
						<a href={repo}>View code</a>
					</li>
				)}
				{live && (
					<li>
						<a href={live}>Live site</a>
					</li>
				)}
			</ul>
		)
	}
	<dl>
		<dt>Year</dt>
		<dd>{work.data.year}</dd>
		<dt>Role</dt>
		<dd>{work.data.role}</dd>
		<dt>Stack</dt>
		<dd>{work.data.stack.join(', ')}</dd>
	</dl>
	<div class="content">
		<Content />
	</div>
</BaseLayout>

<style>
	h1 {
		margin-block-start: var(--space-s);
	}

	.summary {
		margin-block-start: var(--space-xs);
		font-size: var(--step-1);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-s);
		margin-block-start: var(--space-xs);
		padding: 0;
		list-style: none;
	}

	dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-2xs) var(--space-s);
		margin-block-start: var(--space-l);
	}

	dt {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--color-muted);
	}

	.content {
		margin-block-start: var(--space-l);
	}
</style>
