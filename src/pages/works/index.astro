---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import PageHead from '../../components/PageHead.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const works = (await getCollection('works')).sort(
	(a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
	title="Works"
	description="Projects by Vittoria Romano, web development student: the frameworks and tools I used, the features I built and what I learned."
>
	<PageHead
		eyebrow={`${works.length} projects`}
		title="Works"
		lede="A selection of projects from class and from my own time, newest first."
	/>
	<ul>
		{
			works.map((work) => (
				<li>
					<WorkCard
						title={work.data.title}
						summary={work.data.summary}
						year={work.data.year}
						tags={work.data.tags}
						href={`${base}works/${work.id}/`}
						cover={work.data.cover}
						coverAlt={work.data.coverAlt}
					/>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	ul {
		display: grid;
		gap: var(--space-m);
		margin-block-start: var(--space-l);
		padding: 0;
		list-style: none;
	}
</style>
