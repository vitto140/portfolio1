---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const passions = await getCollection('passions');
	return passions.map((passion) => ({
		params: { id: passion.id },
		props: { passion },
	}));
}

const { passion } = Astro.props;
const { Content } = await render(passion);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title={passion.data.title} description={passion.data.summary}>
	<p><a href={`${base}passions/`}>← All passions</a></p>
	<h1>{passion.data.title}</h1>
	<p class="summary">{passion.data.summary}</p>
	<Image
		class="cover"
		src={passion.data.cover}
		alt={passion.data.coverAlt}
		widths={[320, 640, 960, 1600]}
		sizes="(min-width: 70rem) 70rem, 100vw"
	/>
	<div class="content flow">
		<Content />
	</div>
</BaseLayout>

<style>
	h1 {
		margin-block-start: var(--space-s);
	}

	.summary {
		margin-block-start: var(--space-xs);
		font-size: var(--step-1);
	}

	.cover {
		inline-size: 100%;
		block-size: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		margin-block-start: var(--space-l);
	}

	.content {
		margin-block-start: var(--space-l);
	}
</style>
