---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PassionCard from '../../components/PassionCard.astro';
import PageHead from '../../components/PageHead.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const passions = (await getCollection('passions')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
	title="Passions"
	description="Passions of Vittoria Romano, web development student: why I love them and how they show up in my work."
>
	<PageHead
		eyebrow="Off the screen"
		title="Passions"
		lede="The things I love outside of code, and how they shape the way I work."
	/>
	<ul>
		{
			passions.map((passion) => (
				<li>
					<PassionCard
						title={passion.data.title}
						summary={passion.data.summary}
						href={`${base}passions/${passion.id}/`}
						cover={passion.data.cover}
						coverAlt={passion.data.coverAlt}
					/>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	ul {
		display: grid;
		gap: var(--space-m);
		margin-block-start: var(--space-l);
		padding: 0;
		list-style: none;
	}
</style>
