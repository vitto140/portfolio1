---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import PassionCard from '../components/PassionCard.astro';
import Meadow from '../components/Meadow.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const works = (await getCollection('works'))
	.sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title))
	.slice(0, 3);
const passions = (await getCollection('passions')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
	title="Vittoria Romano"
	description="Portfolio of Vittoria Romano, web development student: works, passions and how to reach me."
>
	<section class="hero flow">
		<h1>Vittoria Romano</h1>
		<p>I'm a web development student who builds mobile first.</p>
		<p><a href={`${base}about/`}>About me</a></p>
		<Meadow />
	</section>

	<section class="flow">
		<h2>Selected works</h2>
		<ul>
			{
				works.map((work) => (
					<li>
						<WorkCard
							title={work.data.title}
							summary={work.data.summary}
							year={work.data.year}
							tags={work.data.tags}
							href={`${base}works/${work.id}/`}
							cover={work.data.cover}
							coverAlt={work.data.coverAlt}
							headingLevel={3}
						/>
					</li>
				))
			}
		</ul>
		<p><a href={`${base}works/`}>All works</a></p>
	</section>

	<section class="flow">
		<h2>Off the screen</h2>
		<ul>
			{
				passions.map((passion) => (
					<li>
						<PassionCard
							title={passion.data.title}
							summary={passion.data.summary}
							href={`${base}passions/${passion.id}/`}
							cover={passion.data.cover}
							coverAlt={passion.data.coverAlt}
							headingLevel={3}
						/>
					</li>
				))
			}
		</ul>
		<p><a href={`${base}passions/`}>All passions</a></p>
	</section>
</BaseLayout>

<style>
	/* Fill the screen below the header and main's top padding.
	   4.8rem is the closed header at 320px: name and menu button on one row.
	   The meadow sits behind the hero; the padding keeps the text above it,
	   so the text never covers the moon or the flowers.
	   Meadow: 9rem at 320px -> 18rem at 1400px */
	.hero {
		--meadow-block-size: clamp(9rem, 6.333rem + 13.333vw, 18rem);

		position: relative;
		isolation: isolate;
		display: grid;
		align-content: center;
		min-block-size: calc(100svh - 4.8rem - var(--space-xl));
		padding-block-end: var(--meadow-block-size);
	}

	.hero h1 {
		font-size: clamp(3rem, 1.519rem + 7.407vw, 8rem);
		line-height: 0.95;
	}

	section + section {
		margin-block-start: var(--space-2xl);
	}

	ul {
		display: grid;
		gap: var(--space-m);
		margin-block-start: var(--space-l);
		padding: 0;
		list-style: none;
	}

	/* Two side by side from 36em: one card across the full width is too wide */
	@media (min-width: 36em) {
		ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Four in a row from 64em: two cards leave too much empty space */
	@media (min-width: 64em) {
		ul {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
